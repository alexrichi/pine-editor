{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@pine-highlighter/*": ["../pine-script-syntax-highlighter/src/extension/core/*"]
    }
  },
  "include": ["src", "test"]
}
